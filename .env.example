# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secure_task_api
DB_USERNAME=secure_task_api
DB_PASSWORD=change-me

# JWT (mínimo 32 bytes; genera uno con: openssl rand -base64 48)
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-bytes
# Validez del access token en segundos
JWT_EXPIRATION=3600

# Administrador inicial (opcional). Se crea al arrancar si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Puerto publicado por docker compose
APP_PORT=8080
